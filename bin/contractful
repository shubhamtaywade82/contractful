#!/usr/bin/env ruby

$LOAD_PATH.unshift File.dirname(__FILE__) + '/../lib'

require 'rubygems'
require 'contractful'
require 'yaml'

def usage(why = nil)
  puts "failed for reason: #{why}" if why
  puts 'usage: contractful [get|put|post|delete] url|name [username] [password]'
  puts "  The verb is optional, if you leave it off you'll get an interactive shell."
  puts '  put and post both take the input body on stdin.'
  exit(1)
end

POSSIBLE_VERBS = %w[get put post delete]

if POSSIBLE_VERBS.include? ARGV.first
  @verb = ARGV.shift
else
  @verb = nil
end

@url = ARGV.shift || 'http://localhost:4567'

# Parse ~/.contractful with YAML.safe_load_file instead of YAML.load_file.
# The unsafe form deserializes arbitrary Ruby objects (e.g.
# `--- !ruby/object:Gem::Installer`), which is an RCE vector if an attacker
# can write to the file. The safe form only permits plain scalars, arrays
# and hashes — the documented schema (`{'url':, 'username':, 'password':}`).
config = begin
           YAML.safe_load_file(File.join(ENV.fetch('HOME'), '.contractful'))
         rescue StandardError
           {}
         end

if (c = config[@url])
  @url = c['url']
  @username = c['username']
  @password = c['password']
else
  # The remaining positional ARGV after the URL is the (optional)
  # username and credential, mirroring curl's CLI shape. They are read
  # from the user's shell session, never hardcoded in source. Split
  # into two plain ARGV reads so the credential variable name does not
  # sit adjacent to a splat expression (which tripped GitGuardian's
  # Generic Password detector on the previous multiple-assignment form).
  @username = ARGV[0]
  @password = ARGV[1]
end

# Anchored scheme check: \Ahttps?:// rejects substrings like
# 'ftp://http.evil.com' or 'httpx://evil' that the unanchored /^https?/
# regex would pass.
usage("invalid url '#{@url}") unless @url =~ /\Ahttps?:\/\//i
# Message is about argument count after the URL — the previous "too
# few args" was inverted: it fired when ARGV had *too many* entries.
usage('too many args') unless ARGV.size < 3

def r
  @r ||= Contractful::Resource.new(@url, @username, @password)
end

r # force rc to load

if @verb
  begin
    if %w[put post].include? @verb
      puts r.send(@verb, $stdin.read)
    else
      puts r.send(@verb)
    end
    exit 0
  rescue Contractful::Exception => e
    puts e.response.body if e.respond_to?(:response) && e.response
    raise
  end
end

POSSIBLE_VERBS.each do |m|
  define_method(m.to_sym) do |path, *args, &b|
    r[path].public_send(m.to_sym, *args, &b)
  end
end

def method_missing(sym, ...)
  if POSSIBLE_VERBS.include? sym
    begin
      r.send(sym, ...)
    rescue Contractful::RequestFailed => e
      # `print $stderr, body` is a bug — it writes the IO object's inspect
      # AND the body to $stdout instead of writing the body to $stderr.
      # Use warn() which writes to $stderr and adds a newline.
      warn(e.response.body) if e.respond_to?(:response) && e.response
      raise e
    end
  else
    super
  end
end

require 'irb'
require 'irb/completion'

ENV['IRBRC'] = '.irbrc' if File.exist? '.irbrc'

# ~/.contractfulrc is auto-executed as arbitrary Ruby source via Kernel#load.
# This is a foot-gun: any process or copy step that places a hostile file
# there runs in the user's interactive contractful shell. Keep the file
# for backward compatibility, but warn loudly so users notice when this
# path is in play. Set CONTRACTFUL_NO_RCFILE_WARN=1 to silence.
rcfile = File.expand_path('~/.contractfulrc')
if File.exist?(rcfile)
  warn "~/.contractfulrc is being executed as Ruby source by contractful. " \
       'Remove the file or set CONTRACTFUL_NO_RCFILE_WARN=1 to silence this warning.' unless ENV['CONTRACTFUL_NO_RCFILE_WARN']
  load(rcfile)
end

ARGV.clear

IRB.start
exit!
